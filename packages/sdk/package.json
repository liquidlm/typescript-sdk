{
  "name": "@liquidlm/sdk",
  "version": "0.1.0-alpha.0",
  "description": "Typed LiquidLM client for hosted and self-hosted APIs",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contract",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "contract:check": "node scripts/generate-types.mjs --check",
    "build": "npm run contract:check && tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "5.0.3",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liquidlm/typescript-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/liquidlm/typescript-sdk#readme",
  "bugs": "https://github.com/liquidlm/typescript-sdk/issues"
}
