{
  "name": "@liquidlm/cli",
  "version": "0.2.0-alpha.1",
  "description": "Command-line interface for LiquidLM — log in, manage scoped tokens, install the MCP server, search or upload to your knowledge vaults, and fetch media URLs locally with yt-dlp.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "liquidlm": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "liquidlm",
    "cli",
    "mcp",
    "knowledge-base",
    "rag"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^15.0.0",
    "open": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.21.0",
    "@liquidlm/sdk": "0.1.0-alpha.0",
    "esbuild": "0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liquidlm/typescript-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/liquidlm/typescript-sdk#readme",
  "bugs": "https://github.com/liquidlm/typescript-sdk/issues"
}
